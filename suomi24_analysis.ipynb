    "for title in titles:\n",
    "    text = []\n",
    "    for item in title:\n",
    "        filtered = {\n",
    "            \" \".join(\n",
    "                word for word in sentence.split()\n",
    "                if word.lower() not in finnish_stopwords\n",
    "            )\n",
    "            for sentence in title[item]\n",
    "        }\n",
    "        print(filtered)\n",
    "        text.extend(filtered)\n",
    "\n",
    "    plt.figure(figsize=(8, 4))\n",
    "    plt.imshow(WordCloud(width=800, height=400).generate(\" \".join(text)), interpolation=\"bilinear\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.tight_layout(pad=0)\n",
