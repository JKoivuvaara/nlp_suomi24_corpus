   "source": [
    "# 6\n",
    "# Estimating Heaps' law's parameters\n",
    "\n",
    "for query in queries:\n",
    "    word = words_df[words_df[\"query\"] == query]\n",
    "    word = word[\n",
    "        (word[\"total_words\"] > 0) &\n",
    "        (word[\"unique_words\"] > 0)\n",
    "    ]\n",
    "    x = np.log(word[\"total_words\"])\n",
    "    y = np.log(word[\"unique_words\"])\n",
    "    \n",
    "    # convert x, and y to log scale and then fit a line\n",
    "    # y =  a*x + b\n",
    "    # get Heaps' law's parameters with:\n",
    "    # log(V_R) = a * log(n) + b\n",
    "    # V_R = e^b * n^a\n",
    "    \n",
    "    a, b = np.polyfit(x, y, 1)\n",
    "    y_pred = a * x + b\n",
    "    \n",
    "    RSS = np.sum((y - y_pred) ** 2)         # residual sum of squares\n",
    "    TSS = np.sum((y - np.mean(y)) ** 2)     # total sum of squares\n",
    "    r2 = 1 - RSS / TSS                      # R²\n",
    "    \n",
    "    n = len(x)      # number of observations\n",
    "    p = 1           # number of predictors\n",
    "    \n",
    "    adjusted_r2 = 1 - ( (1 - r2) * (n - 1) / (n - p - 1))\n",
    "        \n",
    "    # print(f\"Query: {query}\")\n",
    "    # print(f\"Slope = {a:.4f}\")\n",
    "    # print(f\"Intercept = {b:.4f}\")\n",
    "    # print(f\"R² = {r2:.4f}\")\n",
    "    \n",
    "    x_line = np.linspace(\n",
    "        word[\"total_words\"].min(),\n",
    "        word[\"total_words\"].max(),\n",
    "        100\n",
    "    )\n",
    "    y_line = np.exp(b) * x_line**a\n",
    "        \n",
    "    plt.figure(figsize=(10, 6))\n",
    "    \n",
    "    plt.plot(\n",
    "        x_line,\n",
    "        y_line,\n",
    "        color=\"red\",\n",
    "        linewidth=2,\n",
    "        label=f\"Linear fit (R²={r2:.3f})\\n\"\n",
    "              f\" R²-adjusted = {adjusted_r2:.3f}\\n\"\n",
    "              f\" y = {a:.3f} x + {b:.3f}\",\n",
    "    )\n",
    "    group = words_df[words_df[\"query\"] == query]\n",
    "\n",
    "    plt.scatter(\n",
    "        group[\"total_words\"],\n",
    "        group[\"unique_words\"],\n",
    "        label=query,\n",
    "        marker=\"o\",\n",
    "        s=5,\n",
    "    )\n",
    "    # for query, group in words_df.groupby(\"query\"):\n",
    "    #     plt.scatter(\n",
    "    #         group[\"total_words\"],\n",
    "    #         group[\"unique_words\"],\n",
    "    #         label=query,\n",
    "    #         marker=\"o\",\n",
    "    #         s=5,\n",
    "    #     )\n",
    "    \n",
    "    plt.xscale(\"log\")\n",
    "    plt.yscale(\"log\")\n",
    "    \n",
    "    plt.title(f'Heaps\\' Law: \"{query}\", linear fit with the R²-method.\\nLog-log scale')\n",
    "    plt.xlabel(\"Total Words (log)\")\n",
    "    plt.ylabel(\"Total Unique Words (log)\")\n",
    "    plt.grid(True)\n",
    "    plt.legend(title=\"Query\")\n",
    "    \n",
    "    \n",
    "    plt.show()\n",
    "    \n",
    "    #### normal scale, transform linear model to exponential form\n",
    "    # log(V_R) = a * log(n) + b\n",
    "    # V_R = e^beta * n^a\n",
    "    beta = a\n",
    "    K = np.e ** b\n",
    "    \n",
    "    \n",
    "    plt.figure(figsize=(10, 6))\n",
    "    \n",
    "    plt.plot(\n",
    "        x_line,\n",
    "        y_line,\n",
    "        color=\"red\",\n",
    "        linewidth=2,\n",
    "        label=f\"Linear fit (R²={r2:.3f})\\n\"\n",
    "              f\" R²-adjusted = {adjusted_r2:.3f}\\n\"\n",
    "              f\"Heaps' law:\" # y = {a:.3f} x + {b:.3f}\\n\"\n",
    "              f\" V_r(n) = Kn^β = {K:.3f}n^{beta:.3f}\",\n",
    "    )\n",
    "    \n",
    "    plt.scatter(\n",
    "        group[\"total_words\"],\n",
    "        group[\"unique_words\"],\n",
    "        label=query,\n",
    "        marker=\"o\",\n",
    "        s=5,\n",
    "    )\n",
    "    # for query, group in words_df.groupby(\"query\"):\n",
    "    #     plt.scatter(\n",
    "    #         group[\"total_words\"],\n",
    "    #         group[\"unique_words\"],\n",
    "    #         label=query,\n",
    "    #         marker=\"o\",\n",
    "    #         s=5,\n",
    "    #     )\n",
    "    \n",
    "    plt.title(f'Heaps\\' Law: \"{query}\", linear fit with the R²-method.')\n",
    "    plt.xlabel(\"Total Words (log)\")\n",
    "    plt.ylabel(\"Total Unique Words (log)\")\n",
    "    plt.grid(True)\n",
    "    plt.legend(title=\"Query\")\n",
    "    \n",
