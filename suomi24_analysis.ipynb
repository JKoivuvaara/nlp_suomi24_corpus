   "source": [
    "# 5\n",
    "# yearly evolution of vocabulary in threads associated with a query\n",
    "\n",
    "rows = []\n",
    "for query in vocabularies:\n",
    "    for corpus_name in vocabularies[query]:\n",
    "        thread_count = len(vocabularies[query][corpus_name])\n",
    "        vocab_count = 0\n",
    "        for thread_vocab in vocabularies[query][corpus_name].values():\n",
    "            vocab_count += len(thread_vocab)\n",
    "\n",
    "        vocab_avg = vocab_count / thread_count if thread_count > 0 else 0\n",
    "        \n",
    "        rows.append({\n",
    "            \"query\": query,\n",
    "            \"year\": corpus_name[-8:-4],\n",
    "            \"vocab_avg\": vocab_avg\n",
    "        })\n",
    "\n",
    "df = pd.DataFrame(rows).sort_values(\n",
    "    by=[\"query\", \"year\"],\n",
    "    ascending=[True, True]\n",
    ")\n",
    "print(df)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "sns.lineplot(\n",
    "    data=df,\n",
    "    x=\"year\",\n",
    "    y=\"vocab_avg\",\n",
    "    hue=\"query\",\n",
    "    marker=\"o\"\n",
    ")\n",
    "# plt.yscale(\"log\")\n",
    "\n",
    "plt.title(\"Yearly Evolution of Vocabulary Size of Threads by Query\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Average Vocabulary Size of Threads\")\n",
    "plt.grid(True)\n",
    "plt.legend(title=\"Query\")\n",
    "plt.show()"
   ],
