    "import zipfile\n",
    "from collections import defaultdict\n",
    "import pandas as pd\n",
    "\n",
    "import archive_reader as ar\n",
    "\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": [
    "    vocabularies = {\n",
    "        query: {  # query as string\n",
    "            corpus_name: {  # path as string\n",
    "                thread_id: {    # byte, you have to do this: \"123456\".encode(\"utf-8\")\n",
    "                    lemma: count    # byte: int\n",
    "                }\n",
    "            }\n",
    "        }\n",
    "    }"
   ],
   "id": "e6ec9b05e678622c"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "queries = [\"deradik\", \"maltillistu\", \"polaris\", \"radik\"]\n",
    "suomi24_zip = \"suomi24-2001-2017-vrt-v1-3.zip\"  # path to zip file\n",
    "\n",
    "# get zip archive file names\n",
    "with zipfile.ZipFile(suomi24_zip, mode=\"r\") as zf:\n",
    "    names = zf.namelist()[0:17]  # include 2001-2017, exclude LICENSE.txt and README.txt\n",
    "\n",
    "# load relevant information with archive_reader\n",
    "ar.query(queries, suomi24_zip)\n",
    "# query_json = ar.get_query(queries[0])  # access individual query results\n",
    "vocabularies = ar.scan(queries, suomi24_zip)"
   ],
   "id": "d359eac0a7e67f3a",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "# query_json = ar.get_query(queries[1])  # access individual query results\n",
    "\n",
    "# print(query_json)"
   ],
   "id": "4be62591fadeac38",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "# 3\n",
    "# yearly evolution of threads associated with a query\n",
    "\n",
    "rows = []\n",
    "for query in vocabularies:\n",
    "    for corpus_name in vocabularies[query]:\n",
    "        thread_count = len(vocabularies[query][corpus_name])\n",
    "\n",
    "        rows.append({\n",
    "            \"query\": query,\n",
    "            \"year\": corpus_name[-8:-4],\n",
    "            \"thread_count\": thread_count\n",
    "        })\n",
    "\n",
    "df = pd.DataFrame(rows).sort_values(\n",
    "    by=[\"query\", \"year\"],\n",
    "    ascending=[True, True]\n",
    ")\n",
    "print(df)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "sns.lineplot(\n",
    "    data=df,\n",
    "    x=\"year\",\n",
    "    y=\"thread_count\",\n",
    "    hue=\"query\",\n",
    "    marker=\"o\"\n",
    ")\n",
    "# plt.yscale(\"log\")\n",
    "\n",
    "plt.title(\"Yearly Evolution of Threads by Query\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Number of Threads\")\n",
    "plt.grid(True)\n",
    "plt.legend(title=\"Query\")\n",
    "plt.show()"
   ],
   "id": "1dbcfec83b8a70a4",
   "outputs": [],
   "execution_count": null
  },
  {
   "metadata": {},
   "cell_type": "code",
   "source": [
    "# 4\n",
    "# yearly evolution of tokens in threads associated with a query\n",
    "\n",
    "rows = []\n",
    "for query in vocabularies:\n",
    "    for corpus_name in vocabularies[query]:\n",
    "        thread_count = len(vocabularies[query][corpus_name])\n",
    "        token_count = 0\n",
    "        for thread_vocab in vocabularies[query][corpus_name].values():\n",
    "            token_count += sum(thread_vocab.values())\n",
    "\n",
    "        vocab_avg = token_count / thread_count if thread_count > 0 else 0\n",
    "        \n",
    "        rows.append({\n",
    "            \"query\": query,\n",
    "            \"year\": corpus_name[-8:-4],\n",
    "            \"token_avg\": vocab_avg\n",
    "        })\n",
    "\n",
    "df = pd.DataFrame(rows).sort_values(\n",
    "    by=[\"query\", \"year\"],\n",
    "    ascending=[True, True]\n",
    ")\n",
    "print(df)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "\n",
    "sns.lineplot(\n",
    "    data=df,\n",
    "    x=\"year\",\n",
    "    y=\"token_avg\",\n",
    "    hue=\"query\",\n",
    "    marker=\"o\"\n",
    ")\n",
    "# plt.yscale(\"log\")\n",
    "\n",
    "plt.title(\"Yearly Evolution of Token Counts of Threads by Query\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Average token count of Threads\")\n",
    "plt.grid(True)\n",
    "plt.legend(title=\"Query\")\n",
    "plt.show()"
   ],
   "id": "64c1f4c3363d063",
   "outputs": [],
   "execution_count": null
  },
